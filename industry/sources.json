        "summaryPaths": [
          "long_description",
          "one_liner"
        ],
        "publishedAtPath": "launched_at",
        "publishedAtUnit": "epoch_s",
        "externalIdPath": "id",
        "urlTemplate": "https://www.ycombinator.com/companies/{slug}",
        "summaryIsBody": true,
        "sortByPublishedAt": true,
